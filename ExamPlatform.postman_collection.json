{
  "info": {
    "name": "Exam Platform API",
    "description": "Complete API collection for the Online Examination Platform (JEE/NEET/CUET scale). Covers User Auth, Exam Management, Test Engine, and Results.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "exam-platform-v1"
  },
  "variable": [
    { "key": "baseUrl",    "value": "http://localhost:8080",  "type": "string" },
    { "key": "authToken",  "value": "",                       "type": "string" },
    { "key": "examId",     "value": "",                       "type": "string" },
    { "key": "sessionId",  "value": "",                       "type": "string" },
    { "key": "userId",     "value": "",                       "type": "string" }
  ],
  "item": [

    {
      "name": "1. User Service",
      "item": [

        {
          "name": "Register Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  if (json.userId) pm.collectionVariables.set('userId', json.userId);",
                  "  pm.test('Registration successful', () => pm.response.to.have.status(pm.response.code));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/register", "host": ["{{baseUrl}}"], "path": ["api","users","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Student\",\n  \"email\": \"student@example.com\",\n  \"password\": \"Test@1234\",\n  \"phone\": \"9876543210\",\n  \"role\": \"STUDENT\"\n}"
            }
          }
        },

        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/register", "host": ["{{baseUrl}}"], "path": ["api","users","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Exam Admin\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@1234\",\n  \"phone\": \"9876543211\",\n  \"role\": \"ADMIN\"\n}"
            }
          }
        },

        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  if (json.token)  pm.collectionVariables.set('authToken', json.token);",
                  "  if (json.userId) pm.collectionVariables.set('userId', json.userId);",
                  "  pm.test('Login successful and token saved', () => pm.expect(json.token).to.not.be.empty);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/login", "host": ["{{baseUrl}}"], "path": ["api","users","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"Test@1234\"\n}"
            }
          }
        },

        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  if (json.token) pm.collectionVariables.set('authToken', json.token);",
                  "  pm.test('Admin login successful', () => pm.expect(json.token).to.not.be.empty);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/login", "host": ["{{baseUrl}}"], "path": ["api","users","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@1234\"\n}"
            }
          }
        },

        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/otp/send", "host": ["{{baseUrl}}"], "path": ["api","users","otp","send"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\"\n}"
            }
          }
        },

        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/otp/verify", "host": ["{{baseUrl}}"], "path": ["api","users","otp","verify"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"otp\": \"123456\"\n}"
            }
          }
        },

        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api","users","me"] }
          }
        },

        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api","users","me"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Student Name\",\n  \"phone\": \"9999999999\"\n}"
            }
          }
        },

        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/refresh", "host": ["{{baseUrl}}"], "path": ["api","users","refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"<your_refresh_token>\"\n}"
            }
          }
        },

        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/logout", "host": ["{{baseUrl}}"], "path": ["api","users","logout"] }
          }
        }

      ]
    },

    {
      "name": "2. Exam Service",
      "item": [

        {
          "name": "Create Exam (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  if (json.examId || json.id) pm.collectionVariables.set('examId', json.examId || json.id);",
                  "  pm.test('Exam created', () => pm.response.to.have.status(pm.response.code));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/exams", "host": ["{{baseUrl}}"], "path": ["api","exams"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"JEE Main Mock Test 1\",\n  \"description\": \"Full syllabus mock test covering Physics, Chemistry and Mathematics\",\n  \"durationMinutes\": 180,\n  \"totalMarks\": 300,\n  \"passingMarks\": 90,\n  \"startTime\": \"2026-07-01T09:00:00\",\n  \"endTime\": \"2026-07-01T12:00:00\",\n  \"maxAttempts\": 1,\n  \"shuffleQuestions\": true,\n  \"shuffleOptions\": true\n}"
            }
          }
        },

        {
          "name": "Get All Exams",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/exams", "host": ["{{baseUrl}}"], "path": ["api","exams"] }
          }
        },

        {
          "name": "Get Exam by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/exams/{{examId}}", "host": ["{{baseUrl}}"], "path": ["api","exams","{{examId}}"] }
          }
        },

        {
          "name": "Update Exam (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/exams/{{examId}}", "host": ["{{baseUrl}}"], "path": ["api","exams","{{examId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"JEE Main Mock Test 1 - Updated\",\n  \"durationMinutes\": 200\n}"
            }
          }
        },

        {
          "name": "Delete Exam (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/exams/{{examId}}", "host": ["{{baseUrl}}"], "path": ["api","exams","{{examId}}"] }
          }
        },

        {
          "name": "Get Available Slots",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/exams/{{examId}}/slots", "host": ["{{baseUrl}}"], "path": ["api","exams","{{examId}}","slots"] }
          }
        },

        {
          "name": "Enroll in Exam",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/exams/{{examId}}/enroll", "host": ["{{baseUrl}}"], "path": ["api","exams","{{examId}}","enroll"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"<slot_id>\"\n}"
            }
          }
        },

        {
          "name": "Get My Enrollments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/exams/enrollments/me", "host": ["{{baseUrl}}"], "path": ["api","exams","enrollments","me"] }
          }
        },

        {
          "name": "Add Question to Exam (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/exams/{{examId}}/questions", "host": ["{{baseUrl}}"], "path": ["api","exams","{{examId}}","questions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionText\": \"What is the SI unit of force?\",\n  \"type\": \"MCQ\",\n  \"options\": [\n    { \"label\": \"A\", \"text\": \"Newton\" },\n    { \"label\": \"B\", \"text\": \"Joule\" },\n    { \"label\": \"C\", \"text\": \"Watt\" },\n    { \"label\": \"D\", \"text\": \"Pascal\" }\n  ],\n  \"correctOption\": \"A\",\n  \"marks\": 4,\n  \"negativeMarks\": 1,\n  \"subject\": \"Physics\",\n  \"difficulty\": \"EASY\"\n}"
            }
          }
        },

        {
          "name": "Publish Exam (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/exams/{{examId}}/publish", "host": ["{{baseUrl}}"], "path": ["api","exams","{{examId}}","publish"] }
          }
        }

      ]
    },

    {
      "name": "3. Test Engine",
      "item": [

        {
          "name": "Start Exam Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json.sessionId) pm.collectionVariables.set('sessionId', json.sessionId);",
                  "  pm.test('Session started', () => pm.expect(json.sessionId).to.not.be.empty);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/sessions/start", "host": ["{{baseUrl}}"], "path": ["api","sessions","start"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"examId\": \"{{examId}}\"\n}"
            }
          }
        },

        {
          "name": "Get Session State",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/sessions/{{sessionId}}", "host": ["{{baseUrl}}"], "path": ["api","sessions","{{sessionId}}"] }
          }
        },

        {
          "name": "Get Questions for Session",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/questions", "host": ["{{baseUrl}}"], "path": ["api","sessions","{{sessionId}}","questions"] }
          }
        },

        {
          "name": "Save Answer (Autosave)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/answer", "host": ["{{baseUrl}}"], "path": ["api","sessions","{{sessionId}}","answer"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionId\": \"<question_id>\",\n  \"selectedOption\": \"A\",\n  \"timeTakenSeconds\": 45\n}"
            }
          }
        },

        {
          "name": "Mark Question for Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/mark-review", "host": ["{{baseUrl}}"], "path": ["api","sessions","{{sessionId}}","mark-review"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionId\": \"<question_id>\",\n  \"marked\": true\n}"
            }
          }
        },

        {
          "name": "Submit Exam",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/submit", "host": ["{{baseUrl}}"], "path": ["api","sessions","{{sessionId}}","submit"] }
          }
        },

        {
          "name": "Resume Session (After Disconnect)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/sessions/resume", "host": ["{{baseUrl}}"], "path": ["api","sessions","resume"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"examId\": \"{{examId}}\"\n}"
            }
          }
        },

        {
          "name": "Report Anti-Cheat Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/anti-cheat", "host": ["{{baseUrl}}"], "path": ["api","sessions","{{sessionId}}","anti-cheat"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"TAB_SWITCH\",\n  \"timestamp\": \"2026-06-08T10:15:30\",\n  \"details\": \"Student switched to another tab\"\n}"
            }
          }
        }

      ]
    },

    {
      "name": "4. Result Service",
      "item": [

        {
          "name": "Get My Result",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/results/me/{{examId}}", "host": ["{{baseUrl}}"], "path": ["api","results","me","{{examId}}"] }
          }
        },

        {
          "name": "Get All Results for Exam (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/results/exam/{{examId}}", "host": ["{{baseUrl}}"], "path": ["api","results","exam","{{examId}}"] }
          }
        },

        {
          "name": "Get Rank List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/results/exam/{{examId}}/ranks?page=0&size=50",
              "host": ["{{baseUrl}}"],
              "path": ["api","results","exam","{{examId}}","ranks"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "50" }
              ]
            }
          }
        },

        {
          "name": "Get Percentile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/results/me/{{examId}}/percentile", "host": ["{{baseUrl}}"], "path": ["api","results","me","{{examId}}","percentile"] }
          }
        },

        {
          "name": "Get Score Analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/results/me/{{examId}}/analytics", "host": ["{{baseUrl}}"], "path": ["api","results","me","{{examId}}","analytics"] }
          }
        },

        {
          "name": "Trigger Result Computation (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/results/exam/{{examId}}/compute", "host": ["{{baseUrl}}"], "path": ["api","results","exam","{{examId}}","compute"] }
          }
        }

      ]
    },

    {
      "name": "5. Health Checks",
      "item": [

        {
          "name": "API Gateway Health",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/actuator/health", "host": ["http://localhost:8080"], "path": ["actuator","health"] }
          }
        },
        {
          "name": "User Service Health",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8081/actuator/health", "host": ["http://localhost:8081"], "path": ["actuator","health"] }
          }
        },
        {
          "name": "Exam Service Health",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8082/actuator/health", "host": ["http://localhost:8082"], "path": ["actuator","health"] }
          }
        },
        {
          "name": "Test Engine Health",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8083/actuator/health", "host": ["http://localhost:8083"], "path": ["actuator","health"] }
          }
        },
        {
          "name": "Result Service Health",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8084/actuator/health", "host": ["http://localhost:8084"], "path": ["actuator","health"] }
          }
        }

      ]
    }

  ]
}
